aws_region = "us-east-1"

# Existing VPC to scan for subnets and ENIs
vpc_id = "vpc-0123456789abcdef0"

# Local path to the probe installer zip (copied to the instance as probe.zip)
probe_installer_path = "./probe.zip"

# Public subnet (route 0.0.0.0/0 to an Internet Gateway)
probe_subnet_id = "subnet-0123456789abcdef0"

# CIDRs allowed to SSH. Use your public IP as /32 in production.
allowed_ssh_cidrs = ["203.0.113.10/32"]

# Optional: limit which ENIs are mirrored (default = all eligible ENIs in the VPC)
# subnet_ids      = ["subnet-aaa", "subnet-bbb"]
# source_eni_ids  = ["eni-aaa", "eni-bbb"]
# exclude_eni_ids = ["eni-skip-me"]

instance_type    = "t3.xlarge"
root_volume_size = 50

tags = {
  Environment = "lab"
}
