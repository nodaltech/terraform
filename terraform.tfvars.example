aws_region = "us-west-2"

vpc_id = "vpc-xxxxxxxx"

# Subnet for both probe NICs. May be private. Must belong to vpc_id.
# Needs NAT or SSM/S3 VPC endpoints, or set associate_public_ip_address = true
# when the subnet only has an Internet Gateway route.
probe_subnet_id = "subnet-xxxxxxxx"

# Local path to the probe installer zip (staged to private S3, installed via SSM)
probe_installer_path = "probe.zip"

# Required for production: pin the ENI(s) to mirror.
source_eni_ids = [
  "eni-xxxxxxxx"
]

# Opt-in only: mirror all account-owned EC2 ENIs in the VPC (can affect unrelated workloads).
# enable_eni_auto_discovery = true
# subnet_ids      = ["subnet-aaa", "subnet-bbb"]
# exclude_eni_ids = ["eni-skip-me"]

instance_type    = "t3.xlarge"
root_volume_size = 50

associate_public_ip_address = false

# Optional emergency SSH (not used for install). Default is no inbound SSH.
# key_name          = "existing-operator-key"
# allowed_ssh_cidrs = ["203.0.113.10/32"]

tags = {
  Environment = "dev"
  Owner       = "infrastructure"
}
